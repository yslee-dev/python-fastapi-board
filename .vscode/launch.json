{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: 서버 디버그",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Pytest: 현재 파일 디버그",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-vv"],
      "justMyCode": true
    }
  ]
}
